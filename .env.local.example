# ─────────────────────────────────────────────────────────────────
# LinkedIn Content Funnel — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── 1. GEMINI AI (Content Generation) ────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day — more than enough to start
# Without this key: the system uses demo/mock content (still sends email)
GEMINI_API_KEY=

# ── 2. RESEND (Email Delivery) ────────────────────────────────────
# Get your API key at: https://resend.com (free: 3,000 emails/month)
# REQUIRED — without this key, NO emails will be sent
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address you send FROM
# Option A (Testing immediately): Use onboarding@resend.dev
#   → Can only deliver to the email you signed up to Resend with
# Option B (Production): Use your own domain e.g. contact@anuj4u.in
#   → Requires DNS verification at resend.com/domains (takes ~5 min)
RESEND_FROM_EMAIL=contact@anuj4u.in

# Your own email — gets a BCC copy of every submission (your lead log)
ADMIN_EMAIL=contact@anuj4u.in

# ── 3. GOOGLE SHEETS (Lead Storage) ──────────────────────────────
# Optional but recommended — stores every submission in a Google Sheet
# Setup: See google-apps-script.js in this folder for instructions
# Without this: leads are still logged to your inbox via ADMIN_EMAIL BCC
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
